# Personal Finance Tracking System - Environment Configuration
# Copy this file to .env and fill in your local/development values
# DO NOT commit .env to version control (use .env.example for defaults only)

# =============================================================================
# BACKEND SERVER CONFIGURATION
# =============================================================================

# Port where backend HTTP server listens
PORT=8080

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL 16)
# =============================================================================

# Host and port of PostgreSQL server
DB_HOST=localhost
DB_PORT=5432

# Database name, user, and password
DB_NAME=finance_tracker
DB_USER=postgres
DB_PASSWORD=postgres

# SSL mode for database connection
# Options: disable, allow, prefer, require, verify-ca, verify-full
DB_SSL_MODE=disable

# Connection pool settings (optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# =============================================================================
# DATABASE MIGRATIONS
# =============================================================================

# Directory containing migration files
MIGRATION_DIR=./backend/migrations

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration
# Secret key for signing JWT tokens (minimum 32 characters for production)
JWT_SECRET=dev-secret-key-min-32-chars-for-production

# JWT token expiry time in seconds (2592000 = 30 days)
JWT_EXPIRY=2592000

# Session management
# Session cookie max age in seconds
SESSION_MAX_AGE=2592000

# Passkey/Webauthn configuration (optional)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080

# =============================================================================
# BANK API INTEGRATIONS (Sandbox/Testing)
# =============================================================================

# GoCardless (Primary PSD2 Aggregator)
# Get credentials from https://sandbox.gocardless.com/
GOCARDLESS_CLIENT_ID=sandbox_client_id_here
GOCARDLESS_CLIENT_SECRET=sandbox_client_secret_here
GOCARDLESS_API_BASE=https://api.sandbox.gocardless.com

# GoCardless Access Token (if using token-based auth instead of OAuth)
GOCARDLESS_ACCESS_TOKEN=sandbox_access_token_here

# Salt Edge (Secondary Aggregator)
# Get credentials from https://www.saltedge.com/api_reference
SALTEDGE_CLIENT_ID=sandbox_client_id_here
SALTEDGE_CLIENT_SECRET=sandbox_client_secret_here
SALTEDGE_API_BASE=https://www.saltedge.com/api/v5

# Sandbox/Testing Mode
# Use mock bank API responses instead of real API calls
ENABLE_MOCK_BANK_API=true

# =============================================================================
# ENCRYPTION & KEY MANAGEMENT
# =============================================================================

# Cloud KMS Configuration (AWS KMS or Azure Key Vault)
# For local development, can use local vault or KMS endpoint

# KMS provider: aws, azure, or local
KMS_PROVIDER=local

# KMS Endpoint (for local/development)
KMS_ENDPOINT=http://localhost:9000

# KMS Key ID (or ARN for AWS, vault URL for Azure)
KMS_KEY_ID=dev-key-id

# Master Key for Vault Service (development only)
# For production, use KMS to manage this
VAULT_MASTER_KEY=dev-vault-master-key-32-chars-min

# TLS Configuration
# For development: disable or use self-signed certs
TLS_ENABLED=false
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# =============================================================================
# OBSERVABILITY & MONITORING
# =============================================================================

# Logging Configuration
# Log level: debug, info, warn, error, critical
LOG_LEVEL=debug

# Log format: json, text
LOG_FORMAT=text

# OpenTelemetry Configuration (Optional)
# OTEL endpoint for receiving metrics and traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_TIMEOUT=10s

# Enable/disable tracing and metrics
ENABLE_TRACING=false
ENABLE_METRICS=false

# Datadog Configuration (Optional)
# DATADOG_API_KEY=your-datadog-api-key
# DATADOG_SITE=datadoghq.com
# DATADOG_ENV=development

# =============================================================================
# MOBILE APP CONFIGURATION
# =============================================================================

# These can be set in mobile/pubspec.yaml or as environment variables

# Backend API Base URL (what the mobile app calls)
API_BASE_URL=http://localhost:8080
API_TIMEOUT=30s

# Enable mock bank API for testing (mobile side)
ENABLE_MOCK_BANK_API_MOBILE=true

# SQLite Configuration (local database)
# Path to SQLite database file (default: app-specific directory)
# SQLITE_DB_PATH=./finance_tracker.db

# Encryption for local database
# Whether to encrypt SQLite database
ENCRYPT_LOCAL_DB=true

# =============================================================================
# FEATURE FLAGS & CONFIGURATION
# =============================================================================

# Enable/disable features during development
FEATURE_BANK_API_INTEGRATION=true
FEATURE_TRANSACTION_MATCHING=true
FEATURE_MULTI_ACCOUNT=true
FEATURE_OFFLINE_SYNC=true

# Configuration
# Bank sync schedule (cron expression or interval)
BANK_SYNC_SCHEDULE=0 0 * * *  # Daily at midnight

# Transaction matching threshold
MATCHING_AMOUNT_DELTA_PERCENT=10
MATCHING_DATE_DELTA_DAYS=1

# Data retention (days)
DATA_RETENTION_DAYS=2555  # ~7 years

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Email Configuration for Notifications (Optional)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=test@example.com
# SMTP_PASSWORD=password
# NOTIFICATION_EMAIL_FROM=noreply@finance-tracker.local

# Redis Configuration (Optional, for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Testing Configuration
# Whether to use in-memory databases for tests
USE_TEST_DB=true
TEST_DB_HOST=localhost
TEST_DB_PORT=5432

# =============================================================================
# GOVERNANCE & COMPLIANCE
# =============================================================================

# GDPR Configuration
# Data deletion grace period (days)
DATA_DELETION_GRACE_PERIOD=30

# Audit log retention (days)
AUDIT_LOG_RETENTION_DAYS=2555  # ~7 years

# DORA Compliance
# Uptime SLA target (percentage)
UPTIME_SLA=99.0

# PSD2 Configuration
# Permission consent expiry (days)
PSD2_PERMISSION_EXPIRY_DAYS=90

# =============================================================================
# NOTES FOR DEVELOPMENT
# =============================================================================

# LOCAL DEVELOPMENT:
# - Create .env file from this template: cp .env.example .env
# - Fill in sandbox API credentials from service providers
# - Use docker-compose up to start PostgreSQL
# - Run: go run ./cmd/server/main.go
#
# TESTING:
# - Use ENABLE_MOCK_BANK_API=true to avoid real API calls
# - Tests create temporary databases; DB credentials needed
#
# PRODUCTION:
# - Use .env.prod with real KMS, certificates, production API credentials
# - Never commit .env to version control
# - Rotate JWT_SECRET regularly
# - Use environment-specific secrets management (AWS Secrets Manager, HashiCorp Vault, etc.)

# =============================================================================
